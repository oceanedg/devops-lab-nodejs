{
  "info": {
    "name": "Healthcare API Tests - Doctors",
    "description": "Lab 5: tests of the /api/doctors routes",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "GET all doctors",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Response is an array\", function () {",
              "  pm.expect(pm.response.json()).to.be.an(\"array\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/doctors",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "doctors"
          ]
        }
      },
      "response": []
    },
    {
      "name": "POST new doctor",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "pm.test(\"New doctor has an id\", function () {",
              "  pm.expect(pm.response.json()).to.have.property(\"id\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/doctors",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "doctors"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Dr. Paul Martin\",\n  \"specialty\": \"Dermatology\"\n}"
        }
      },
      "response": []
    },
    {
      "name": "POST doctor without specialty",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 400\", function () {",
              "  pm.response.to.have.status(400);",
              "});",
              "pm.test(\"Error message is returned\", function () {",
              "  pm.expect(pm.response.json().error).to.eql(\"Missing required fields\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/doctors",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "doctors"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Dr. No Specialty\"\n}"
        }
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ]
}
