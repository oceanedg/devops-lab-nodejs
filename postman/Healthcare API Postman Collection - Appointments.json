      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 404\", function () {",
              "  pm.response.to.have.status(404);",
              "});",
              "pm.test(\"Doctor not found\", function () {",
              "  pm.expect(pm.response.json().error).to.eql(\"Doctor not found\");",
